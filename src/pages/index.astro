---
import Layout from "../layouts/Layout.astro";

import PeepWindow from "../components/PeepWindow.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
---

<Layout>
  <div class="fixed top-4 right-4 z-50 sm:top-8 sm:right-8">
    <ThemeToggle />
  </div>

  <main
    class="mx-auto flex min-h-dvh w-full max-w-7xl items-center px-6 py-6 sm:px-10 sm:py-20 lg:px-16 lg:py-32"
  >
    <div
      class="w-full lg:grid lg:grid-cols-[45ch_19rem] lg:items-center lg:justify-center lg:gap-60"
    >
      <div class="text-base leading-relaxed sm:text-lg">
        <header>
          <h1 class="text-2xl font-medium tracking-tight sm:text-4xl">
            I build software that removes work.
          </h1>

          <p class="mt-1 text-neutral-600 dark:text-neutral-300">
            Software engineer, product mindset, backend bias.
          </p>
        </header>

        <section class="mt-7">
          <p>Pragmatic over clever. Product before technology.</p>

          <p
            class="mt-4 text-sm text-neutral-500 sm:text-base dark:text-neutral-400"
          >
            Mostly <span class="font-medium text-[#3178C6]">
              TypeScript
            </span>.<br />
            Curious by default.
          </p>
        </section>

        <nav
          class="mt-8 flex flex-col items-start gap-4 text-sm sm:text-base"
          aria-label="Projects"
        >
          <div>
            <a
              class="group inline-flex items-baseline gap-2"
              href="https://github.com/Facupelli/depiqo"
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="text-neutral-400 transition-transform duration-200 group-hover:translate-x-px group-hover:-translate-y-px dark:text-neutral-500"
                aria-hidden="true"
              >
                ↗
              </span>

              <span class="underline-offset-4 group-hover:underline">
                DEPIQO
              </span>
            </a>

            <p
              class="mt-0.5 pl-5 text-xs text-neutral-500 sm:text-sm dark:text-neutral-400"
            >
              Rental management SaaS for inventory, pricing and bookings.
            </p>
          </div>

          <div>
            <a
              class="group inline-flex items-baseline gap-2"
              href="https://github.com/Facupelli/divide-expenses-bot"
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="text-neutral-400 transition-transform duration-200 group-hover:translate-x-px group-hover:-translate-y-px dark:text-neutral-500"
                aria-hidden="true"
              >
                ↗
              </span>

              <span class="underline-offset-4 group-hover:underline">
                DIVIDE EXPENSES
              </span>
            </a>

            <p
              class="mt-0.5 pl-5 text-xs text-neutral-500 sm:text-sm dark:text-neutral-400"
            >
              AI-powered expense splitting from natural language.
            </p>
          </div>

          <div>
            <a
              class="group inline-flex items-baseline gap-2"
              href="https://github.com/Facupelli/Social-Movies-Club"
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="text-neutral-400 transition-transform duration-200 group-hover:translate-x-px group-hover:-translate-y-px dark:text-neutral-500"
                aria-hidden="true"
              >
                ↗
              </span>

              <span class="underline-offset-4 group-hover:underline">
                QUE VES
              </span>
            </a>

            <p
              class="mt-0.5 pl-5 text-xs text-neutral-500 sm:text-sm dark:text-neutral-400"
            >
              Social movie discovery and recommendations PWA.
            </p>
          </div>
        </nav>

        <section class="mt-8">
          <h2 class="text-xs text-neutral-500 sm:text-sm dark:text-neutral-400">
            Lately
          </h2>

          <p class="mt-1">
            Computer networks, AI agents, homebrewing, and whatever makes me
            want to know how it actually works.
          </p>
        </section>

        <footer
          class="mt-8 text-sm text-neutral-500 sm:text-base dark:text-neutral-400"
        >
          <p>San Juan, Argentina</p>

          <nav
            class="mt-1 flex items-center gap-x-1.5"
            aria-label="Social links"
          >
            <a
              class="underline-offset-4 transition-all duration-200 hover:underline"
              href="https://github.com/Facupelli"
              target="_blank"
              rel="noreferrer"
            >
              GitHub,
            </a>

            <a
              class="underline-offset-4 transition-all duration-200 hover:underline"
              href="https://www.linkedin.com/in/facundopellicer"
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn
            </a>
          </nav>
        </footer>
      </div>

      <div class="hidden lg:flex lg:justify-center">
        <PeepWindow />
      </div>
    </div>
  </main>
</Layout>
