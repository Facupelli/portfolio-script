---
import Layout from "../layouts/Layout.astro";
import PeepWindow from "../components/PeepWindow.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

const projects = [
  {
    name: "DEPIQO",
    description: "Rental management for equipment businesses.",
    href: "https://github.com/Facupelli/depiqo",
  },
  {
    name: "DIVIDE EXPENSES",
    description: "Split expenses using natural language.",
    href: "https://github.com/Facupelli/divide-expenses-bot",
  },
  {
    name: "QUE VES",
    description: "Discover movies through people whose taste you trust.",
    href: "https://github.com/Facupelli/Social-Movies-Club",
  },
];
---

<Layout>
  <div class="site-shell">
    <div class="topbar">
      <ThemeToggle />
    </div>

    <main class="portfolio-layout">
      <section
        class="intro"
        aria-labelledby="headline"
      >
        <h1 id="headline">
          I build web software, from the database to the browser.
        </h1>

        <p>
          I enjoy getting into the details, understanding why things work the
          way they do, and finding ways to make them simpler.
        </p>

        <p>
          I mostly work with TypeScript, but I'm not tied to any language or
          framework. I'm happy to learn what I need to solve the problem.
        </p>
      </section>

      <div
        class="illustration"
        aria-label="Window into my workspace"
      >
        <PeepWindow />
      </div>

      <section
        class="projects"
        aria-labelledby="projects-heading"
      >
        <h2 id="projects-heading">A few things I've built</h2>

        <nav aria-label="Selected projects">
          <ul class="project-list">
            {
              projects.map((project) => (
                <li class="project-item">
                  <a
                    class="project-link"
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="project-name">{project.name}</span>
                    <span class="project-description">
                      {project.description}
                    </span>
                    <span
                      class="project-arrow"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </section>

      <p class="recent">
        Lately, I've been reading about computer networks, experimenting with AI
        agents, and trying my hand at homebrewing.
      </p>

      <footer class="footer">
        <span>San Juan, Argentina</span>
        <nav
          class="social-links"
          aria-label="Social profiles"
        >
          <a
            href="https://github.com/Facupelli"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a
            href="https://www.linkedin.com/in/facundopellicer"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </footer>
    </main>
  </div>
</Layout>

<style>
  .site-shell {
    position: relative;
    width: 100%;
    max-width: 1200px;
    min-height: 100svh;
    margin: 0 auto;
    padding: 0 50px;
  }

  .topbar {
    height: 88px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    color: var(--color-muted);
  }

  .portfolio-layout {
    display: grid;
    grid-template-columns: minmax(0, 620px) minmax(250px, 1fr);
    column-gap: clamp(44px, 6vw, 95px);
    align-items: start;
    padding-top: clamp(40px, 6.6vh, 84px);
    padding-bottom: 85px;
  }

  .intro {
    grid-column: 1;
    grid-row: 1;
  }

  h1 {
    max-width: 660px;
    margin: 0 0 31px;
    color: var(--color-text);
    font-size: 43px;
    font-weight: 560;
    line-height: 1.15;
    letter-spacing: -0.046em;
    text-wrap: pretty;
  }

  .intro p {
    max-width: 595px;
    margin: 0 0 17px;
    color: var(--color-body);
    font-size: 16px;
    line-height: 1.66;
    letter-spacing: -0.005em;
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  .illustration {
    grid-column: 2;
    grid-row: 1 / span 4;
    align-self: center;
    justify-self: center;
    width: min(100%, 335px);
    filter: brightness(1.09) drop-shadow(0 17px 18px var(--window-shadow));
  }

  /* Keep the existing PeepWindow component, including any interactions it has. */
  .illustration > :global(*) {
    max-width: 100%;
  }

  .projects {
    grid-column: 1;
    grid-row: 2;
    margin-top: 44px;
  }

  .projects h2 {
    margin: 0 0 17px;
    color: var(--color-text);
    font-size: 15px;
    font-weight: 520;
    line-height: 1.66;
    letter-spacing: -0.008em;
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-item:not(:last-child) {
    border-bottom: 1px solid var(--color-line);
  }

  .project-link {
    display: grid;
    grid-template-columns: 164px minmax(0, 1fr) 16px;
    gap: 18px;
    align-items: baseline;
    padding: 12px 0 13px;
    border-radius: 2px;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .project-name {
    color: var(--color-text);
    font-size: 14px;
    font-weight: 550;
    line-height: 1.4;
    letter-spacing: 0.004em;
  }

  .project-description {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .project-arrow {
    color: var(--color-faint);
    font-size: 15px;
    line-height: 1;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .project-link:hover .project-name {
    text-decoration: underline;
  }

  .project-link:hover .project-arrow,
  .project-link:focus-visible .project-arrow {
    color: var(--color-accent);
    transform: translate(2px, -2px);
  }

  .project-link:focus-visible,
  .social-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .recent {
    grid-column: 1;
    grid-row: 3;
    max-width: 615px;
    margin: 33px 0 0;
    color: var(--color-body);
    font-size: 16px;
    line-height: 1.66;
  }

  .footer {
    grid-column: 1;
    grid-row: 4;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 11px 30px;
    margin-top: 42px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.66;
  }

  .social-links {
    display: flex;
    gap: 18px;
  }

  .social-links a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 4px;
    transition: color 180ms ease;
  }

  .social-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 920px) {
    .site-shell {
      padding: 0 32px;
    }

    .portfolio-layout {
      grid-template-columns: minmax(0, 1fr) minmax(200px, 32%);
      column-gap: 45px;
      padding-top: 40px;
    }

    h1 {
      font-size: clamp(34px, 4.4vw, 43px);
    }

    .project-link {
      grid-template-columns: 135px minmax(0, 1fr) 12px;
      gap: 11px;
    }
  }

  @media (max-width: 700px) {
    .site-shell {
      padding: 0 25px;
    }

    .topbar {
      height: 75px;
    }

    .portfolio-layout {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 33px;
      padding-bottom: 75px;
      row-gap: 0;
    }

    h1 {
      margin-bottom: 25px;
      font-size: clamp(33px, 7.3vw, 43px);
      line-height: 1.17;
    }

    .illustration {
      grid-column: 1;
      grid-row: 2;
      width: min(65%, 230px);
      margin: 30px auto 6px;
    }

    .projects {
      grid-column: 1;
      grid-row: 3;
      margin-top: 35px;
    }

    .project-link {
      grid-template-columns: minmax(0, 1fr) 15px;
      gap: 3px 12px;
      padding: 12px 0;
    }

    .project-name {
      grid-column: 1;
    }

    .project-description {
      grid-column: 1;
      grid-row: 2;
    }

    .project-arrow {
      grid-column: 2;
      grid-row: 1;
    }

    .recent {
      grid-column: 1;
      grid-row: 4;
      margin-top: 29px;
    }

    .footer {
      grid-column: 1;
      grid-row: 5;
      margin-top: 35px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-arrow,
    .social-links a {
      transition: none;
    }
  }
</style>
