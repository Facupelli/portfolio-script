<button
  type="button"
  class="relative -m-2 inline-flex size-9 items-center justify-center rounded-full transition-opacity duration-200 hover:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
  data-theme-toggle
  aria-label="Switch to dark mode"
  aria-pressed="false"
  title="Switch to dark mode"
>
  <span
    class="absolute transition-[opacity,transform] duration-300 ease-out dark:scale-75 dark:rotate-45 dark:opacity-0 motion-reduce:transition-none"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 24 24"
      class="size-4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.8A8.2 8.2 0 1 1 11.2 3 6.4 6.4 0 0 0 21 12.8Z"></path>
    </svg>
  </span>

  <span
    class="absolute scale-75 -rotate-45 opacity-0 transition-[opacity,transform] duration-300 ease-out dark:scale-100 dark:rotate-0 dark:opacity-100 motion-reduce:transition-none"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 24 24"
      class="size-4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
    >
      <circle cx="12" cy="12" r="3.5"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
  </span>
</button>

<script>
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  const updateToggle = (theme: "light" | "dark") => {
    const isDark = theme === "dark";
    const label = isDark ? "Switch to light mode" : "Switch to dark mode";

    for (const toggle of toggles) {
      toggle.setAttribute("aria-pressed", String(isDark));
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
    }
  };

  const setTheme = (theme: "light" | "dark") => {
    root.classList.toggle("dark", theme === "dark");
    root.dataset.theme = theme;

    try {
      localStorage.setItem("theme", theme);
    } catch {}

    updateToggle(theme);
  };

  updateToggle(root.classList.contains("dark") ? "dark" : "light");

  for (const toggle of toggles) {
    toggle.addEventListener("click", () => {
      setTheme(root.classList.contains("dark") ? "light" : "dark");
    });
  }
</script>
