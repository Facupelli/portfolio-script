---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Facundo Pellicer",
  description = "Product engineer with a backend and systems bias.",
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="scheme-light dark:scheme-dark"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="description"
      content={description}
    />
    <title>{title}</title>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        let storedTheme = null;

        try {
          storedTheme = localStorage.getItem("theme");
        } catch {}

        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;

        const theme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : systemPrefersDark
              ? "dark"
              : "light";

        root.classList.toggle("dark", theme === "dark");
        root.dataset.theme = theme;
      })();
    </script>

    <Font
      cssVariable="--font-instrument-sans"
      preload
    />
  </head>

  <body
    class="min-h-dvh bg-[#fafafa] font-sans text-[#11110f] antialiased transition-colors duration-380 ease-out motion-reduce:transition-none dark:bg-[#0d0f10] dark:text-[#f1eee8]"
  >
    <slot />
  </body>
</html>
